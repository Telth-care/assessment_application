# Public — safe in the browser (used by app/page.tsx for the anon candidate insert)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server only, never prefix with NEXT_PUBLIC_. Used by app/api/* routes to
# read questions, score attempts and write results, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — server only. From resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain you verified in Resend, e.g. results@yourdomain.com
# While testing without a verified domain, use onboarding@resend.dev — but see the
# README note: sandbox mode then only delivers to your own Resend account email.
RESEND_FROM_EMAIL=onboarding@resend.dev
